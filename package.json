{
  "name": "one-stop-shop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/oss", "packages/car-catalog"],
  "engines": { "node": ">=22.12.0 <25" },
  "scripts": {
    "dev": "npm run dev --workspace @oss/web -- --host 127.0.0.1",
    "build": "npm run validate:catalog && npm run typecheck && npm run build --workspace @oss/web",
    "preview": "npm run preview --workspace @oss/web -- --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:catalog": "tsx scripts/validate-catalog.ts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "npm run check:boundaries && npm run test && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
