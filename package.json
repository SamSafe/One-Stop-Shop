{
  "name": "one-stop-shop",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/oss",
    "packages/car-catalog"
  ],
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "npm run dev --workspace @oss/web -- --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "preview": "npm run preview --workspace @oss/web -- --host 127.0.0.1",
    "start": "node scripts/serve.mjs",
    "package:release": "npm run check && node scripts/package-release.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:catalog": "node --import tsx scripts/validate-catalog.ts",
    "catalog:sync": "node --import tsx scripts/sync-nrcan.ts",
    "catalog:coverage": "node --import tsx scripts/catalog-coverage.ts",
    "catalog:sync:subaru": "node --import tsx scripts/sync-subaru.ts",
    "catalog:sync:tci": "node --import tsx scripts/sync-tci.ts",
    "catalog:sync:honda": "node --import tsx scripts/sync-honda.ts",
    "catalog:sync:ford": "node --import tsx scripts/sync-ford.ts",
    "catalog:sync:mazda": "node --import tsx scripts/sync-mazda.ts",
    "catalog:sync:hyundai": "node --import tsx scripts/sync-hyundai.ts",
    "catalog:sync:kia": "node --import tsx scripts/sync-kia.ts",
    "catalog:sync:gm": "node --import tsx scripts/sync-gm.ts",
    "catalog:sync:nissan": "node --import tsx scripts/sync-nissan.ts",
    "catalog:sync:volkswagen": "node --import tsx scripts/sync-volkswagen.ts",
    "catalog:sync:mitsubishi": "node --import tsx scripts/sync-mitsubishi.ts",
    "catalog:sync:polestar": "node --import tsx scripts/sync-polestar.ts",
    "catalog:sync:bmw": "node --import tsx scripts/sync-bmw.ts",
    "catalog:capture:bmw-stock": "node scripts/capture-bmw-stock.mjs",
    "catalog:sync:mini": "node --import tsx scripts/sync-mini.ts",
    "catalog:capture:mini-stock": "node scripts/capture-mini-stock.mjs",
    "catalog:sync:genesis": "node --import tsx scripts/sync-genesis.ts",
    "catalog:sync:rivian": "node --import tsx scripts/sync-rivian.ts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "npm run check:boundaries && npm run test && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
